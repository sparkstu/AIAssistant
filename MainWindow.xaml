<Window x:Class="WpfDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AI 助手" Height="900" Width="1400"
        Icon="Assets/AppIcon.ico"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="BgPrimary" Color="#1a1a2e"/>
        <SolidColorBrush x:Key="BgSurface" Color="#242438"/>
        <SolidColorBrush x:Key="BgInput" Color="#2e2e44"/>
        <SolidColorBrush x:Key="BorderColor" Color="#383852"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#e8e8f0"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9898b0"/>
        <SolidColorBrush x:Key="AccentColor" Color="#7c3aed"/>
        <SolidColorBrush x:Key="AccentHover" Color="#8b5cf6"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#22c55e"/>
        <SolidColorBrush x:Key="ErrorColor" Color="#ef4444"/>
        <SolidColorBrush x:Key="WarningColor" Color="#f59e0b"/>

        <!-- CheckBox 样式 -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="CheckBorder"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="8,4"
                                BorderThickness="1"
                                BorderBrush="Transparent"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="CheckBox"
                                        Width="16" Height="16"
                                        CornerRadius="3"
                                        Background="#2e2e44"
                                        BorderBrush="#505070"
                                        BorderThickness="1"
                                        Margin="0,0,8,0">
                                    <Path x:Name="CheckMark"
                                          Data="M4,8 L7,11 L12,5"
                                          Stroke="#7c3aed"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBox" Property="Background" Value="#2e1a5e"/>
                                <Setter TargetName="CheckBox" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                <Setter TargetName="CheckBorder" Property="Background" Value="#2a1a4e"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#28283e"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 发送按钮 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#38385a"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#50508a"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 小工具按钮 -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ToolBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToolBorder" Property="Background" Value="#2e2e46"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="2">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="8,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#50508a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: 选择工具栏 -->
        <Border Grid.Row="0" Background="#1f1f36" BorderBrush="#383852" BorderThickness="0,0,0,1"
                Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧: 厂商选择 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="chkDoubao"    Content="豆包"     Checked="VendorCheck_Changed" Unchecked="VendorCheck_Changed"/>
                    <CheckBox x:Name="chkQianwen"   Content="千问"     Checked="VendorCheck_Changed" Unchecked="VendorCheck_Changed"/>
                    <CheckBox x:Name="chkDeepSeek"  Content="DeepSeek" Checked="VendorCheck_Changed" Unchecked="VendorCheck_Changed"/>
                    <CheckBox x:Name="chkKimi"      Content="Kimi"     Checked="VendorCheck_Changed" Unchecked="VendorCheck_Changed"/>
                    <CheckBox x:Name="chkChatGLM"   Content="智谱清言" Checked="VendorCheck_Changed" Unchecked="VendorCheck_Changed"/>
                    <CheckBox x:Name="chkYiyan"     Content="文心一言" Checked="VendorCheck_Changed" Unchecked="VendorCheck_Changed"/>
                </StackPanel>

                <!-- 中间: 发送目标提示 -->
                <TextBlock Grid.Column="1" x:Name="targetHint" Text=""
                           FontSize="12" Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" Margin="16,0,0,0"
                           TextTrimming="CharacterEllipsis"/>

                <!-- 右侧: 全选/取消 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="全选" Style="{StaticResource ToolButton}" Click="SelectAll_Click"/>
                    <Button Content="取消" Style="{StaticResource ToolButton}" Click="DeselectAll_Click" Margin="2,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: WebView2 内容区域 -->
        <Grid x:Name="webViewHost" Grid.Row="1" Background="#1a1a2e">
            <!-- 豆包 -->
            <Border x:Name="panelDoubao" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#242438" BorderBrush="#7c3aed" BorderThickness="0,0,0,2"
                            Padding="10,5">
                        <TextBlock Text="豆包" FontSize="13" FontWeight="SemiBold" Foreground="#e8e8f0"/>
                    </Border>
                    <wv2:WebView2 x:Name="webViewDoubao" Grid.Row="1" Source="https://www.doubao.com/chat/"/>
                </Grid>
            </Border>

            <!-- 千问 -->
            <Border x:Name="panelQianwen" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#242438" BorderBrush="#3b82f6" BorderThickness="0,0,0,2"
                            Padding="10,5">
                        <TextBlock Text="千问" FontSize="13" FontWeight="SemiBold" Foreground="#e8e8f0"/>
                    </Border>
                    <wv2:WebView2 x:Name="webViewQianwen" Grid.Row="1" Source="https://www.qianwen.com/chat"/>
                </Grid>
            </Border>

            <!-- DeepSeek -->
            <Border x:Name="panelDeepSeek" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#242438" BorderBrush="#06b6d4" BorderThickness="0,0,0,2"
                            Padding="10,5">
                        <TextBlock Text="DeepSeek" FontSize="13" FontWeight="SemiBold" Foreground="#e8e8f0"/>
                    </Border>
                    <wv2:WebView2 x:Name="webViewDeepSeek" Grid.Row="1" Source="https://chat.deepseek.com/"/>
                </Grid>
            </Border>

            <!-- Kimi -->
            <Border x:Name="panelKimi" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#242438" BorderBrush="#22c55e" BorderThickness="0,0,0,2"
                            Padding="10,5">
                        <TextBlock Text="Kimi" FontSize="13" FontWeight="SemiBold" Foreground="#e8e8f0"/>
                    </Border>
                    <wv2:WebView2 x:Name="webViewKimi" Grid.Row="1" Source="https://kimi.moonshot.cn/"/>
                </Grid>
            </Border>

            <!-- 智谱清言 -->
            <Border x:Name="panelChatGLM" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#242438" BorderBrush="#f59e0b" BorderThickness="0,0,0,2"
                            Padding="10,5">
                        <TextBlock Text="智谱清言" FontSize="13" FontWeight="SemiBold" Foreground="#e8e8f0"/>
                    </Border>
                    <wv2:WebView2 x:Name="webViewChatGLM" Grid.Row="1" Source="https://chatglm.cn/"/>
                </Grid>
            </Border>

            <!-- 文心一言 -->
            <Border x:Name="panelYiyan" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#242438" BorderBrush="#ec4899" BorderThickness="0,0,0,2"
                            Padding="10,5">
                        <TextBlock Text="文心一言" FontSize="13" FontWeight="SemiBold" Foreground="#e8e8f0"/>
                    </Border>
                    <wv2:WebView2 x:Name="webViewYiyan" Grid.Row="1" Source="https://yiyan.baidu.com/"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 2: 底部输入区 -->
        <Border Grid.Row="2" Background="{StaticResource BgSurface}"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0">
            <Grid Margin="12,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 输入行 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="#2e2e4a" CornerRadius="6"
                            Padding="8,0" Margin="0,0,10,0" VerticalAlignment="Stretch">
                        <TextBlock x:Name="tabLabel" Text="豆包"
                                   Foreground="{StaticResource AccentColor}"
                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Border>

                    <TextBox x:Name="inputBox" Grid.Column="1"
                             AcceptsReturn="False"
                             VerticalContentAlignment="Center"
                             KeyDown="InputBox_KeyDown"
                             TextChanged="InputBox_TextChanged"
                             ToolTip="输入内容，按 Enter 发送到所有勾选的 AI"/>

                    <Button x:Name="diagnoseButton" Grid.Column="2" Content="诊断"
                            Style="{StaticResource SecondaryButton}"
                            Margin="10,0,0,0" Click="DiagnoseButton_Click"/>

                    <Button x:Name="sendButton" Grid.Column="3" Content="发送"
                            Style="{StaticResource PrimaryButton}"
                            Margin="8,0,0,0" Click="SendButton_Click"/>
                </Grid>

                <!-- 状态 / 调试 -->
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="statusBar" FontSize="12"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="debugOutput" FontSize="11"
                                   FontFamily="Consolas"
                                   Foreground="#6a6a8a"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="18"
                                   Visibility="Collapsed"
                                   MouseLeftButtonDown="DebugOutput_Click"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="清空" FontSize="11"
                               Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center" Cursor="Hand"
                               Visibility="Collapsed"
                               x:Name="clearDebug"
                               MouseLeftButtonDown="ClearDebug_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
